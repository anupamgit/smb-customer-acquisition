# Copy to .env at repository root. Never commit .env.

# Local server
PORT=8080
# ADVISOR_STAGE_TIMING=1   # optional: log per-stage ms to server stdout (off by default)

# Pipeline audit (local)
# ADVISOR_PIPELINE_AUDIT=1   # writes outputs/audit/{runId}.md

# UI: "How this match was made" on each place (off by default)
# ADVISOR_MATCH_CHAIN=1

# LLM result cache per demo scenario (OpenRouter cost control on public demo)
# ADVISOR_LLM_CACHE=1
# ADVISOR_LLM_CACHE_TTL_SECONDS=300

# Database
# DATABASE_URL=postgres://advisor:advisor-local-only@localhost:5432/advisor?sslmode=disable

# LLM
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=

# Business data: four built-in scenarios (default). Set USE_LIVE_CONNECTOR=1 for an external connector (Square today).
# USE_LIVE_CONNECTOR=1
SCENARIO=coffee-nyc
# SCENARIO_DATA_DIR=
# BUSINESS_TYPE=coffee_shop   # required when USE_LIVE_CONNECTOR=1 (Square path today)

# Square (when USE_LIVE_CONNECTOR=1)
SQUARE_BASE_URL=https://connect.squareupsandbox.com
SQUARE_VERSION=2026-09-16
SQUARE_API_KEY=

# Qloo
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
# QLOO_INSIGHTS_TAKE=50   # max places per Insights call (1–50, default 50)
# QLOO_LOCATION_RADIUS_METERS=10000   # Insights POINT(lon lat) radius (~6.2 mi default)
